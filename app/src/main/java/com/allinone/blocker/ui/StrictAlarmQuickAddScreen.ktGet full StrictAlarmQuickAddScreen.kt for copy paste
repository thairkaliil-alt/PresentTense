/**
 * "Quick add" screen — lets you build a list of DISTINCT times by tapping a
 * time picker repeatedly, then creates one fully independent [StrictAlarmEntry]
 * per time, all in one tap of "Create all".
 *
 * This is NOT the same as the "Snooze burst" toggle inside a single alarm's
 * editor (that makes ONE alarm re-ring several times). Every time queued up
 * here becomes its own separate alarm card on the alarms list — its own
 * on/off switch, its own days, fully independent of the others.
 *
 * Nothing is saved until "Create all" is tapped. Each alarm defaults to all
 * 7 days selected and snooze-burst off; the user can tweak any of them
 * individually afterwards from the normal alarm editor.
 */
@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun StrictAlarmQuickAddScreen(
    onBack: () -> Unit,
    onDone: () -> Unit
) {
    val context = LocalContext.current
    val scope = rememberCoroutineScope()

    // Queued times, as minutes-since-midnight, kept sorted + de-duplicated.
    var queuedMinutes by remember { mutableStateOf(listOf<Int>()) }
    var isCreating by remember { mutableStateOf(false) }

    fun addTime(hour: Int, minute: Int) {
        val total = hour * 60 + minute
        if (total !in queuedMinutes) {
            queuedMinutes = (queuedMinutes + total).sorted()
        }
    }

    fun removeTime(total: Int) {
        queuedMinutes = queuedMinutes.filterNot { it == total }
    }

    fun openTimePicker() {
        val now = Calendar.getInstance()
        TimePickerDialog(
            context,
            { _, hour, minute -> addTime(hour, minute) },
            now.get(Calendar.HOUR_OF_DAY),
            now.get(Calendar.MINUTE),
            false
        ).show()
    }

    fun createAll() {
        if (queuedMinutes.isEmpty() || isCreating) return
        isCreating = true

        // Build every entry FIRST so each one gets its own unique, stable
        // requestCode (nextAlarmRequestCode looks at what's already in the
        // repository, so we have to account for the ones we're about to add
        // before asking for the next one).
        val newEntries = mutableListOf<StrictAlarmEntry>()
        var nextCode = BlockerRepository.nextAlarmRequestCode()
        for (total in queuedMinutes) {
            val entry = StrictAlarmEntry(
                id = BlockerRepository.newStrictAlarmId(),
                requestCode = nextCode,
                hour = total / 60,
                minute = total % 60
            )
            newEntries.add(entry)
            nextCode += 1
        }

        BlockerRepository.addStrictAlarmEntries(newEntries)

        // Tell Android about each new alarm, spaced 3 seconds apart so we
        // don't fire a burst of scheduling calls at once. This only affects
        // how fast we REGISTER the alarms — each one still rings at the
        // exact distinct time it was given.
        scope.launch {
            AlarmScheduler.scheduleAllSpaced(context, newEntries, spacingMillis = 3000L)
            isCreating = false
            onDone()
        }
    }

    Scaffold(
        topBar = {
            TopAppBar(
                title = { Text("Quick add alarms", style = MaterialTheme.typography.titleLarge) },
                navigationIcon = {
                    IconButton(onClick = onBack) {
                        Icon(Icons.AutoMirrored.Filled.ArrowBack, contentDescription = "Back")
                    }
                }
            )
        }
    ) { pad ->
        Column(
            modifier = Modifier
                .padding(pad)
                .fillMaxSize()
                .padding(horizontal = 24.dp, vertical = 16.dp)
        ) {
            Text(
                "Tap \u201cAdd a time\u201d for each alarm you want. Every time becomes its own " +
                    "separate alarm \u2014 its own on/off, its own days \u2014 created together " +
                    "when you tap Create all.",
                style = MaterialTheme.typography.bodyMedium,
                color = TextSecondary
            )

            Spacer(Modifier.height(20.dp))

            // ── "Add a time" button ───────────────────────────────────────
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .shadow(elevation = 3.dp, shape = RoundedCornerShape(14.dp), clip = false)
                    .background(AccentBlue, RoundedCornerShape(14.dp))
                    .pressable(onClick = { openTimePicker() })
                    .padding(vertical = 16.dp),
                horizontalArrangement = Arrangement.Center,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Icon(Icons.Filled.Add, contentDescription = null, tint = Color.White)
                Spacer(Modifier.width(8.dp))
                Text("Add a time", color = Color.White, fontWeight = FontWeight.SemiBold)
            }

            Spacer(Modifier.height(24.dp))

            if (queuedMinutes.isEmpty()) {
                Box(Modifier.fillMaxWidth().padding(top = 24.dp), contentAlignment = Alignment.Center) {
                    Text(
                        "No times added yet",
                        style = MaterialTheme.typography.bodyMedium,
                        color = TextMuted
                    )
                }
            } else {
                Text(
                    "${queuedMinutes.size} alarm${if (queuedMinutes.size == 1) "" else "s"} queued",
                    style = MaterialTheme.typography.labelLarge,
                    fontWeight = FontWeight.SemiBold,
                    color = TextSecondary
                )
                Spacer(Modifier.height(8.dp))
                LazyColumn(modifier = Modifier.weight(1f)) {
                    items(queuedMinutes) { total ->
                        QueuedTimeRow(
                            hour = total / 60,
                            minute = total % 60,
                            onRemove = { removeTime(total) }
                        )
                        Spacer(Modifier.height(10.dp))
                    }
                }
            }

            Spacer(Modifier.height(16.dp))

            SaveButton(
                state = if (isCreating) SaveState.Loading else SaveState.Idle,
                enabled = queuedMinutes.isNotEmpty(),
                onClick = { createAll() }
            )
            Spacer(Modifier.height(8.dp))
        }
    }
}

@Composable
private fun QueuedTimeRow(hour: Int, minute: Int, onRemove: () -> Unit) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .shadow(elevation = 2.dp, shape = RoundedCornerShape(12.dp), clip = false)
            .background(CardSurface, RoundedCornerShape(12.dp))
            .padding(horizontal = 16.dp, vertical = 14.dp),
        horizontalArrangement = Arrangement.SpaceBetween,
        verticalAlignment = Alignment.CenterVertically
    ) {
        Row(verticalAlignment = Alignment.CenterVertically) {
            Box(
                modifier = Modifier
                    .size(34.dp)
                    .background(AccentBlue.copy(alpha = 0.12f), CircleShape),
                contentAlignment = Alignment.Center
            ) {
                Icon(
                    Icons.Filled.Alarm,
                    contentDescription = null,
                    tint = AccentBlue,
                    modifier = Modifier.size(18.dp)
                )
            }
            Spacer(Modifier.width(12.dp))
            Text(
                formatQuickAddTime(hour, minute),
                style = MaterialTheme.typography.titleMedium,
                fontWeight = FontWeight.SemiBold
            )
        }
        IconButton(onClick = onRemove) {
            Icon(Icons.Filled.Close, contentDescription = "Remove time", tint = AccentRed)
        }
    }
}

private fun formatQuickAddTime(hour: Int, minute: Int): String {
    val cal = Calendar.getInstance().apply {
        set(Calendar.HOUR_OF_DAY, hour)
        set(Calendar.MINUTE, minute)
    }
    return java.text.SimpleDateFormat("h:mm a", Locale.getDefault()).format(cal.time)
}
