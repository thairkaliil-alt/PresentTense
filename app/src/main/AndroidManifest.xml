<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core blocking permissions (see README section 12) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Strict Alarm feature: lets us wake the device at an exact time,
         the same way the system Clock app does. USE_EXACT_ALARM is granted
         automatically at install for apps whose core purpose is alarms. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Lets us show Android's own direct "ignore battery optimizations?"
         dialog (Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS) from
         the Permissions screen, instead of sending the user hunting through
         Settings manually. Purely a resilience measure: makes the rare
         "phone kills the whole app in the background" case rarer, which is
         the one case LockdownWatchdogReceiver's heartbeat check exists to
         recover from. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".BlockerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blocker"
        tools:targetApi="34">

        <!-- excludeFromRecents: closes the "swipe Present Tense away in
             Recent Apps" escape hatch. Without this, swiping the app's card
             away in the app-switcher can kill its whole process — including
             the accessibility service that enforces lockdown — which is
             exactly how lockdown was being bypassed. The app is still
             reached normally from the home-screen icon or notification. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Blocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-phone lockdown launcher: the black single-screen "home" shown
             during a lockdown session. Registered as a HOME launcher so that
             pressing Home lands here (strongest when the user sets it as their
             default home app, but it also works purely via the accessibility
             redirect). singleTask + excludeFromRecents keeps it as one
             non-stacking, non-switchable screen. When no lockdown is active it
             immediately hands off to MainActivity, so being default home is safe. -->
        <activity
            android:name=".ui.LockdownLauncherActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Blocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Strict Alarm: full-screen ring/dismiss screen. Shows over the
             lock screen, so it needs showWhenLocked/turnScreenOn handled in
             code (see AlarmRingActivity.kt) and excludeFromRecents so it
             doesn't linger as a confusing app-switcher entry after dismiss. -->
        <activity
            android:name=".ui.AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Blocker" />

        <!-- Accessibility service: detects foreground app and enforces blocks -->
        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Persistent foreground service: keeps the blocker alive in the background -->
        <service
            android:name=".service.BlockerForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App blocking enforcement and usage tracking" />
        </service>

        <!-- Strict Alarm: runs while the alarm is actively ringing (sound +
             vibration) and is what keeps the OS from killing that process
             mid-ring. Android has no "alarm" foregroundServiceType — apps
             holding SCHEDULE_EXACT_ALARM use "specialUse" for this instead,
             same pattern as BlockerForegroundService above. -->
        <service
            android:name=".service.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Alarm ringing playback" />
        </service>

        <!-- Strict Alarm: fired by AlarmManager at the scheduled time, even
             if the phone was asleep or the app wasn't running. -->
        <receiver
            android:name=".receiver.AlarmTriggerReceiver"
            android:exported="false" />

        <!-- Device admin: prevents uninstall during locked sessions -->
        <receiver
            android:name=".admin.BlockerDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

      <!-- Re-arm blocking after reboot -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Geofence: receives enter/exit events from the OS -->
        <receiver
            android:name=".receiver.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Lockdown watchdog: an AlarmManager tick that fires every ~45s
             while a lockdown session is live (see LockdownGuard). It's the
             last line of defense — if the whole app process was killed
             (e.g. swiped out of Recent Apps), this still wakes up in a
             fresh process and restores the lockdown screen. -->
        <receiver
            android:name=".receiver.LockdownWatchdogReceiver"
            android:exported="false" />

        <!-- Scheduled lockdown trigger: an exact AlarmManager wake-up set
             by LockdownScheduleAlarms for the precise moment a scheduled
             (or manual) lockdown is due to start, end, or resume after a
             break. This is what makes a scheduled lockdown start ON ITS
             OWN at the right time, even if the phone was asleep and
             Present Tense wasn't running at all. -->
        <receiver
            android:name=".receiver.LockdownScheduleTriggerReceiver"
            android:exported="false" />

    </application>

</manifest>
